---
import MethodologyPage from '../../components/MethodologyPage.astro';
import { LOCALES } from '../../i18n/locales';

export function getStaticPaths() {
  return LOCALES.filter((l) => l.slug !== '').map((l) => ({
    params: { locale: l.slug },
    props: { locale: l },
  }));
}

const { locale } = Astro.props;
---

<MethodologyPage locale={locale} />
