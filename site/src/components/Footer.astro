---
import { LOCALES, localeHome, localePath, t, type Locale, type Page } from '../i18n/locales';
import facts from '../generated/facts.json';

interface Props {
  locale: Locale;
  page: Page;
}
const { locale, page } = Astro.props;
const home = localeHome(locale);
const year = new Date().getFullYear();

const product = [
  { label: t(locale, 'nav.how'), href: `${home}#how-it-works` },
  { label: t(locale, 'nav.features'), href: `${home}#features` },
  { label: t(locale, 'nav.screens'), href: `${home}#screenshots` },
  { label: t(locale, 'nav.compare'), href: `${home}#compare` },
  { label: t(locale, 'nav.faq'), href: `${home}#faq` },
];
const resources = [
  { label: t(locale, 'footer.help'), href: `${home}help/` },
  // v1.121.0 — on-site Methodology / Changelog / License pages.
  { label: t(locale, 'nav.methodology'), href: `${home}methodology/` },
  { label: t(locale, 'footer.changelog'), href: `${home}changelog/` },
  { label: t(locale, 'footer.license'), href: `${home}license/` },
  { label: t(locale, 'footer.readme'), href: `${facts.repoUrl}#readme` },
  // v1.147.0 — deep-link to the Hermes + Telegram integration guide.
  { label: t(locale, 'footer.hermes'), href: `${facts.repoUrl}/blob/main/docs/integrations/HERMES.md` },
  { label: t(locale, 'footer.releases'), href: `${facts.repoUrl}/releases` },
  { label: t(locale, 'footer.parentDocs'), href: `${facts.parentUrl}/docs` },
  { label: t(locale, 'footer.parentMethodology'), href: `${facts.parentUrl}/methodology` },
];
const community = [
  { label: 'GitHub', href: facts.repoUrl },
  { label: t(locale, 'footer.issues'), href: `${facts.repoUrl}/issues` },
  // Discussions are not enabled on the repo — link the wiki instead.
  { label: 'Wiki', href: `${facts.repoUrl}/wiki` },
  // The OpenWorker coworker — run the whole job search from andrewyng/openworker.
  { label: 'OpenWorker coworker', href: 'https://github.com/Fighter90/career-ops-coworker' },
  { label: t(locale, 'footer.contributing'), href: `${facts.repoUrl}/blob/main/CONTRIBUTING.md` },
  // v1.120.0 — parent v1.20.0 parity: the CareerOps Manifesto.
  { label: t(locale, 'footer.manifesto'), href: 'https://career-ops.org/manifesto' },
];

// Product Hunt "post embed" card — pinned at the very end of the site.
// Injected via set:html so the inline-style entities pass through untouched.
const phCard = `<div style="font-family: -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif; border: 1px solid rgb(224, 224, 224); border-radius: 12px; padding: 20px; max-width: 500px; background: rgb(255, 255, 255); box-shadow: rgba(0, 0, 0, 0.05) 0px 2px 8px;"><div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;"><img alt="career-ops-ui" src="https://ph-files.imgix.net/c289ef7c-caa3-4f6b-847c-4585b8b176e6.png?auto=compress,format&amp;codec=mozjpeg&amp;cs=strip&amp;fit=crop&amp;h=80&amp;w=80" style="width: 64px; height: 64px; border-radius: 8px; object-fit: cover; flex-shrink: 0;"><div style="flex: 1 1 0%; min-width: 0px;"><h3 style="margin: 0px; font-size: 18px; font-weight: 600; color: rgb(26, 26, 26); line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">career-ops-ui</h3><p style="margin: 4px 0px 0px; font-size: 14px; color: rgb(102, 102, 102); line-height: 1.4; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">The open-source job search command center</p></div></div><a href="https://www.producthunt.com/products/career-ops-ui?embed=true&amp;utm_source=embed&amp;utm_medium=post_embed" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; gap: 4px; margin-top: 12px; padding: 8px 16px; background: rgb(255, 97, 84); color: rgb(255, 255, 255); text-decoration: none; border-radius: 8px; font-size: 14px; font-weight: 600;">Check it out on Product Hunt →</a></div>`;
---

<footer class="border-t border-line bg-paper py-14">
  <div class="container-site">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <nav aria-label={t(locale, 'footer.product')}>
        <h2 class="mb-3 text-sm font-bold uppercase tracking-wide text-ink-faint">{t(locale, 'footer.product')}</h2>
        <ul class="space-y-2">
          {product.map((l) => (
            <li><a href={l.href} class="text-sm text-ink-soft hover:text-ink hover:underline">{l.label}</a></li>
          ))}
        </ul>
      </nav>
      <nav aria-label={t(locale, 'footer.resources')}>
        <h2 class="mb-3 text-sm font-bold uppercase tracking-wide text-ink-faint">{t(locale, 'footer.resources')}</h2>
        <ul class="space-y-2">
          {resources.map((l) => (
            <li><a href={l.href} rel={l.href.startsWith('http') ? 'noopener' : undefined} class="text-sm text-ink-soft hover:text-ink hover:underline">{l.label}</a></li>
          ))}
        </ul>
      </nav>
      <nav aria-label={t(locale, 'footer.community')}>
        <h2 class="mb-3 text-sm font-bold uppercase tracking-wide text-ink-faint">{t(locale, 'footer.community')}</h2>
        <ul class="space-y-2">
          {community.map((l) => (
            <li><a href={l.href} rel="noopener" class="text-sm text-ink-soft hover:text-ink hover:underline">{l.label}</a></li>
          ))}
        </ul>
      </nav>
      <nav aria-label={t(locale, 'footer.languages')}>
        <h2 class="mb-3 text-sm font-bold uppercase tracking-wide text-ink-faint">{t(locale, 'footer.languages')}</h2>
        {/* flex-wrap + nowrap items: long endonyms («Português (Brasil)»)
            must never split mid-name — each language stays on one line. */}
        <ul class="flex flex-wrap gap-x-4 gap-y-2">
          {LOCALES.map((l) => (
            <li>
              <a
                href={localePath(l, page)}
                hreflang={l.code}
                lang={l.code}
                aria-current={l.code === locale.code ? 'true' : undefined}
                class:list={['whitespace-nowrap text-sm text-ink-soft hover:text-ink hover:underline', l.code === locale.code && 'font-bold text-ink']}
              >
                {l.flag} {l.endonym}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-8 flex justify-center" set:html={phCard}></div>
    <div class="mt-8 flex flex-col gap-2 border-t border-line pt-6 text-[0.8rem] text-ink-soft md:flex-row md:items-center md:justify-between">
      <p>
        © {year} career-ops-ui ·
        <a href={`${home}license/`} class="underline underline-offset-2">{t(locale, 'footer.license')}</a>
      </p>
      <p>
        {t(locale, 'footer.createdBy')}
        {' '}<a href="https://sergey-cv.com/" rel="noopener author" class="underline underline-offset-2">Sergei Emelianov</a>
        {' · '}<a href="https://www.linkedin.com/in/sergey-emelyanov-in-job/" rel="noopener" class="underline underline-offset-2">LinkedIn</a>
      </p>
      <p>{t(locale, 'open.disclaimer')}</p>
    </div>

    <div class="mt-10 flex justify-center">
      <a href="https://www.producthunt.com/products/career-ops-ui?embed=true&amp;utm_source=badge-featured&amp;utm_medium=badge&amp;utm_campaign=badge-career-ops-ui" target="_blank" rel="noopener noreferrer"><img alt="career-ops-ui - The open-source job search command center | Product Hunt" width="250" height="54" src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1221619&amp;theme=light&amp;t=1786619651408" /></a>
    </div>
  </div>
</footer>
