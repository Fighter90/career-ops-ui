---
import { Picture } from 'astro:assets';
import { t, type Locale } from '../i18n/locales';
import { screenshotFor } from '../lib/screenshots';
import scanEn from '../assets/screenshots/scan-en.png';
import pipelineEn from '../assets/screenshots/pipeline-en.png';
import trackerEn from '../assets/screenshots/tracker-en.png';
import reportsEn from '../assets/screenshots/reports-en.png';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// Every tab renders a real capture of the current v2 UI (the 2026-10-27
// refresh). The dashboard tab shows the reader's own locale capture (synced
// ×19, same family as the job-map shots); the four data-view tabs render the
// EN captures — only EN was captured for them (the ru variants stay in
// images/ru/ for the localized READMEs).
// The dashboard capture sits in hero visibility, so it loads eagerly; the
// rest are below the fold and load lazily.
const TABS = (['dashboard', 'scan', 'pipeline', 'tracker', 'reports'] as const).map((name) => ({
  name,
  label: t(locale, `showcase.tab${name[0].toUpperCase()}${name.slice(1)}`),
  alt: t(locale, `showcase.alt.${name}`),
}));
const SHOTS: Record<string, { src: typeof scanEn; eager: boolean }> = {
  dashboard: { src: screenshotFor(locale.file), eager: true },
  scan: { src: scanEn, eager: false },
  pipeline: { src: pipelineEn, eager: false },
  tracker: { src: trackerEn, eager: false },
  reports: { src: reportsEn, eager: false },
};
const id = 'shots';
const captions = [1, 2, 3].map((i) => ({
  title: t(locale, `showcase.c${i}.title`),
  desc: t(locale, `showcase.c${i}.desc`),
}));
---

<section id="screenshots" class="section">
  <div class="container-site">
    <div class="reveal mb-10 max-w-2xl">
      <h2 class="mb-3 text-3xl font-bold tracking-tight md:text-4xl">{t(locale, 'showcase.h2')}</h2>
      <p class="text-lg text-ink-soft">{t(locale, 'showcase.sub')}</p>
    </div>

    <!-- Reuses the generic [data-install] tab engine from site.js (role=tab,
         arrow keys, aria-selected) — no new client JS. -->
    <div class="reveal" data-install id={id}>
      <div class="shots-tablist needs-js" role="tablist" aria-label={t(locale, 'a11y.shotTabs')}>
        {TABS.map((tab, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${id}-${tab.name}`}
            aria-controls={`panel-${id}-${tab.name}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-tab={tab.name}
            class="install-tab shots-tab border-b-2 border-transparent px-4 py-2 text-sm font-semibold text-ink-soft transition hover:text-ink"
          >
            {tab.label}
          </button>
        ))}
      </div>

      {TABS.map((tab, i) => (
        <div
          class="install-panel shots-panel"
          role="tabpanel"
          id={`panel-${id}-${tab.name}`}
          aria-labelledby={`tab-${id}-${tab.name}`}
          data-panel={tab.name}
          hidden={i !== 0}
        >
          <Picture
            src={SHOTS[tab.name].src}
            alt={tab.alt}
            formats={['avif', 'webp']}
            widths={[640, 960, 1440]}
            sizes="(max-width: 1200px) 94vw, 1160px"
            loading={SHOTS[tab.name].eager ? 'eager' : 'lazy'}
            class="block h-auto w-full"
          />
        </div>
      ))}
    </div>

    <ul class="mt-8 grid gap-6 sm:grid-cols-3">
      {captions.map((c, i) => (
        <li class="reveal flex gap-3">
          <span class="font-mono text-sm font-bold text-[color:var(--color-rausch-deep)]">0{i + 1}</span>
          <div>
            <h3 class="mb-1 font-bold">{c.title}</h3>
            <p class="text-[0.92rem] leading-6 text-ink-soft">{c.desc}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
