---
/**
 * CAR-133 — neutral placeholder for a screenshot slot.
 *
 * Every screenshot this landing previously showed (dashboard-*.png from
 * v1.245.0, job-map-*.png from 2026-10-07) predates the v2 UI: the v2
 * pipeline (CAR-116), tracker kanban (CAR-117) and reports (CAR-118) shipped
 * in v1.260.0, after the last capture. Real replacements need a running
 * browser against the app — CAR-140 owns that. Until then each slot renders
 * this clearly-labelled placeholder instead of a stale capture.
 */
interface Props {
  /** Accessible name for the slot (what the fresh screenshot will show). */
  label: string;
  /** Visible note under the label (i18n-keyed by the caller). */
  note?: string;
  /** CSS aspect-ratio of the reserved space. */
  ratio?: string;
}
const { label, note, ratio = '16 / 10' } = Astro.props;
---

<!-- CAR-140: replace this placeholder with a fresh v2 screenshot (real browser capture against the running app). -->
<div class="shot-slot" role="img" aria-label={label} style={`aspect-ratio:${ratio}`}>
  <div class="shot-slot-inner" aria-hidden="true">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="40"
      height="40"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="shot-slot-icon"
    >
      <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
      <circle cx="9" cy="9" r="2"></circle>
      <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
    </svg>
    <p class="shot-slot-label">{label}</p>
    {note && <p class="shot-slot-note">{note}</p>}
  </div>
</div>
