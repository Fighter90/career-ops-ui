---
import { t, type Locale } from '../i18n/locales';
import ScreenshotSlot from './ScreenshotSlot.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
// CAR-133: the job-map captures on disk (en/ru hand-made 2026-10-07, the rest
// scripted around v1.249.0) predate the dark map tiles (v1.247.0), the
// commute/relevance controls (v1.249.0) and the specialization select
// (v1.251.0) — the section renders a labelled placeholder until CAR-140
// captures the current map. map.alt stays the slot's accessible name.
const captions = [1, 2, 3].map((i) => ({
  title: t(locale, `map.c${i}.title`),
  desc: t(locale, `map.c${i}.desc`),
}));
---

<section id="job-map" class="section">
  <div class="container-site">
    <div class="reveal mb-10 max-w-2xl">
      <span class="mb-3 inline-block rounded-full bg-[color:var(--color-rausch-deep)] px-3 py-1 text-xs font-bold uppercase tracking-wide text-white">{t(locale, 'map.badge')}</span>
      <h2 class="mb-3 text-3xl font-bold tracking-tight md:text-4xl">{t(locale, 'map.h2')}</h2>
      <p class="text-lg text-ink-soft">{t(locale, 'map.sub')}</p>
    </div>

    <div class="reveal overflow-hidden rounded-[24px] border border-line shadow-[var(--shadow-hover)]">
      <ScreenshotSlot label={t(locale, 'map.alt')} note={t(locale, 'map.placeholder')} />
    </div>

    <ul class="mt-8 grid gap-6 sm:grid-cols-3">
      {captions.map((c, i) => (
        <li class="reveal flex gap-3">
          <span class="font-mono text-sm font-bold text-[color:var(--color-rausch-deep)]">0{i + 1}</span>
          <div>
            <h3 class="mb-1 font-bold">{c.title}</h3>
            <p class="text-[0.92rem] leading-6 text-ink-soft">{c.desc}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
