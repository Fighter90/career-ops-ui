---
import { localeHome, t, type Locale } from '../i18n/locales';
import InstallTabs from './InstallTabs.astro';
import Icon from './Icon.astro';
import WatchButton from './WatchButton.astro';
import DemoPanel from './DemoPanel.astro';
import facts from '../generated/facts.json';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const adaptersRounded = Math.floor(facts.adapters / 5) * 5; // honest, registry-derived count
---

<section class="relative overflow-hidden pt-28 pb-16 md:pt-36 md:pb-24">
  <!-- CAR-133 parallax layers: decorative blobs + the demo frame drift at
       different rates on scroll. JS only sets --plx; CSS applies it strictly
       inside `prefers-reduced-motion: no-preference` + fine pointer. -->
  <div class="hero-blob hero-blob-1" aria-hidden="true" data-parallax="0.16"></div>
  <div class="hero-blob hero-blob-2" aria-hidden="true" data-parallax="0.26"></div>

  <div class="container-site relative grid items-center gap-12 lg:grid-cols-2">
    <div class="min-w-0 max-w-xl">
      <div class="hero-seq hero-seq-1">
        <div class="mb-6 flex flex-wrap gap-2">
          <span class="eyebrow-pill">{t(locale, 'hero.pill1')}</span>
          <span class="eyebrow-pill">{t(locale, 'hero.pill2')}</span>
          <span class="eyebrow-pill">{t(locale, 'hero.pill3')}</span>
        </div>
        <h1 class="mb-5 text-[clamp(2.5rem,5vw,4rem)] leading-[1.1] font-extrabold tracking-[-0.02em]">
          {t(locale, 'hero.h1')}
        </h1>
        <p class="mb-2 text-xl leading-relaxed text-ink-soft">
          {t(locale, 'hero.sub').replace('{adapters}', String(adaptersRounded))}
        </p>
        <p class="mb-8 text-xl font-semibold leading-relaxed">
          {t(locale, 'hero.privacy')}
        </p>
      </div>

      <div class="hero-seq hero-seq-2">
        <InstallTabs locale={locale} id="hero-install" />
        <div class="mt-5 flex flex-wrap items-center gap-4">
          <a href={facts.repoUrl} class="btn-secondary" rel="noopener">
            {t(locale, 'hero.ctaGithub')}
            <Icon name="arrow-right" class="mirror-rtl h-4 w-4" />
          </a>
          <a href={`${localeHome(locale)}help/`} class="btn-ghost">
            <Icon name="book-open" class="h-4 w-4" />
            {t(locale, 'hero.ctaDocs')}
          </a>
          <p class="text-sm text-ink-soft">{t(locale, 'hero.fineprint')}</p>
        </div>
        <div class="mt-6">
          <a href="https://www.producthunt.com/products/career-ops-ui?embed=true&amp;utm_source=badge-featured&amp;utm_medium=badge&amp;utm_campaign=badge-career-ops-ui" target="_blank" rel="noopener noreferrer"><img alt="career-ops-ui - The open-source job search command center | Product Hunt" width="250" height="54" src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1221619&amp;theme=light&amp;t=1786619651408" /></a>
        </div>
      </div>
    </div>

    <div
      class="hero-visual hero-seq hero-seq-3 relative min-w-0 lg:-me-16"
      role="img"
      aria-label={t(locale, 'demo.a11y')}
      data-parallax="0.05"
    >
      <div class="rotate-[0.6deg] overflow-hidden rounded-[16px] border border-line bg-paper shadow-[0_24px_60px_rgba(0,0,0,0.16)]">
        <div class="flex items-center gap-2 border-b border-line bg-paper-alt px-4 py-2.5" dir="ltr">
          <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
          <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
          <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
          <span class="ms-3 flex-1 rounded-md border border-line bg-paper px-3 py-0.5 text-center font-mono text-[0.7rem] text-ink-soft">
            127.0.0.1:4317
          </span>
        </div>
        <DemoPanel locale={locale} id="hero-demo" />
      </div>
      <div class="mt-5 flex justify-center">
        <WatchButton locale={locale} class="btn-primary" />
      </div>
    </div>
  </div>
</section>
