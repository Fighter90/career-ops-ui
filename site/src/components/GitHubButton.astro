---
import Icon from './Icon.astro';
import facts from '../generated/facts.json';

interface Props {
  label: string;
  class?: string;
}
const { label, class: className = '' } = Astro.props;
// Star count snapshot from BUILD time (scripts/sync-assets.mjs); site.js
// live-refreshes every [data-gh-stars] from the GitHub API on page load, so
// the badge auto-updates between deploys. With no build value AND no client
// JS the badge stays hidden — the button degrades to a plain GitHub link.
const stars = typeof facts.stars === 'number' ? facts.stars : null;
---

<a href={facts.repoUrl} class={`btn-ghost !px-4 !py-2 text-sm ${className}`} rel="noopener">
  <Icon name="github" class="h-[18px] w-[18px]" />
  <span>{label}</span>
  <span
    class="flex items-center gap-1 border-s border-line ps-2 text-ink-soft"
    data-gh-stars-badge
    hidden={stars === null}
  >
    <Icon name="star" class="h-3.5 w-3.5" />
    <span class="font-mono text-xs" data-gh-stars>{stars !== null ? stars.toLocaleString('en-US') : ''}</span>
  </span>
</a>
