---
/**
 * WatchButton — a "▶ Watch preview" trigger for the VideoModal lightbox.
 * Any number can appear on a page; each carries `data-video-modal`, which the
 * single VideoModal script wires to open the demo video.
 */
import { t, type Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  /** Tailwind class(es) for the button chrome; defaults to the secondary style. */
  class?: string;
}
const { locale, class: cls = 'btn-secondary' } = Astro.props;
---

<button type="button" data-video-modal class={`inline-flex items-center gap-2 ${cls}`}>
  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
  {t(locale, 'video.watch')}
</button>
