{
  "name": "cvstart-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Static multilingual marketing landing for career-ops-ui (cvstart.org). Built with Astro; deployed to GitHub Pages by CI only.",
  "scripts": {
    "predev": "node scripts/sync-assets.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/sync-assets.mjs && node scripts/check-i18n.mjs && node scripts/generate-og.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/figtree": "^5.2.6",
    "@fontsource/jetbrains-mono": "^5.2.6",
    "@tailwindcss/vite": "^4.1.11",
    "astro": "^7.1.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "fast-uri": "^3.1.7"
  }
}
