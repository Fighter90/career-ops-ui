{
  "name": "porch-ui",
  "version": "2.0.0-beta.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src electron tests vite.config.ts",
    "format": "biome check --write src electron tests vite.config.ts",
    "test": "vitest run",
    "test:desktop": "node tests/desktop.mjs",
    "start": "../scripts/porch ui --desktop"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.4",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
